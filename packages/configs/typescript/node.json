{
  "$schema": "https://www.schemastore.org/tsconfig",
  "display": "Node 24",
  "_version": "24.0.0",
  "extends": "./base.json",

  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "nodenext",
    "types": ["node"],
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  }
}
